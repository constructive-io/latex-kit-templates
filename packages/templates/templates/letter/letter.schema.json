{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "letter document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template": {
      "const": "letter"
    },
    "docId": {
      "type": "string",
      "description": "Minted on the first final build; never reuse one."
    },
    "locale": {
      "type": "string",
      "description": "BCP 47 language tag, e.g. en-US or ja-JP."
    },
    "data": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "from": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "line1": {
                  "type": "string"
                },
                "line2": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "postalCode": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "line1",
                "city"
              ]
            },
            "signer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "name"
          ]
        },
        "to": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "organization"
              ]
            },
            "name": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "line1": {
                  "type": "string"
                },
                "line2": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "postalCode": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "line1",
                "city"
              ]
            },
            "signer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            "signature": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "from",
        "to",
        "body"
      ]
    }
  },
  "required": [
    "template",
    "data"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nda document",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "template": {
      "const": "nda"
    },
    "docId": {
      "type": "string",
      "description": "Minted on the first final build; never reuse one."
    },
    "locale": {
      "type": "string",
      "description": "BCP 47 language tag, e.g. en-US or ja-JP."
    },
    "data": {
      "type": "object",
      "properties": {
        "effectiveDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "discloser": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "organization"
              ]
            },
            "name": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "line1": {
                  "type": "string"
                },
                "line2": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "postalCode": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "line1",
                "city"
              ]
            },
            "signer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            "signature": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "recipient": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "person",
                "organization"
              ]
            },
            "name": {
              "type": "string"
            },
            "entityType": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "address": {
              "type": "object",
              "properties": {
                "line1": {
                  "type": "string"
                },
                "line2": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "postalCode": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "required": [
                "line1",
                "city"
              ]
            },
            "signer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "signature": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            "signature": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "mutual": {
          "default": true,
          "type": "boolean"
        },
        "termMonths": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "type": "string"
        },
        "governingLaw": {
          "type": "string"
        },
        "exclusions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exhibits": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "body"
            ]
          }
        }
      },
      "required": [
        "effectiveDate",
        "discloser",
        "recipient",
        "termMonths",
        "purpose",
        "governingLaw"
      ]
    }
  },
  "required": [
    "template",
    "data"
  ],
  "additionalProperties": false
}
